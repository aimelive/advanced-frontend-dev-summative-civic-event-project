# Copy this file to .env and fill in the values for your machine.

# PostgreSQL connection (required)
DB_USER=postgres
DB_PASS=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civic-events-db

# Secret used to sign login tokens (required). Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: port the API listens on (default 4000)
# PORT=4000

# Optional: set to development to include stack traces in error responses
# NODE_ENV=development
